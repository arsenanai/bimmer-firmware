###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-to-a-random-string
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MySQL (default)
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=firmware
DB_USER=root
DB_PASSWORD=
DB_VERSION=8.0

# PostgreSQL
# DB_DRIVER=pdo_pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=firmware
# DB_USER=postgres
# DB_PASSWORD=
# DB_VERSION=16
###< doctrine/doctrine-bundle ###

###> app configuration ###
SHOP_URL="https://newshop.testshop1.bimmer-tech.net/"

# Admin panel credentials (HTTP Basic auth)
# Username is plain text, password must be a bcrypt/argon hash.
# Generate a hash with: php bin/console security:hash-password 'your_password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD='$2y$13$REPLACE_WITH_YOUR_HASHED_PASSWORD'
###< app configuration ###
