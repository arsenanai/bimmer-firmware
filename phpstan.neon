parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        - var
        - vendor
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # EasyAdmin compatibility: TreeBuilder::getRootNode() is deprecated but widely used
        - '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\TreeBuilder::getRootNode\(\)#'
        # EasyAdmin's AbstractCrudController is a generic class but doesn't enforce PHP 8 generics
        - '#Class .+ extends generic class .+AbstractCrudController#'
        # Doctrine's ServiceEntityRepository is generic but doesn't enforce type parameters
        - '#Class .+ extends generic class .+ServiceEntityRepository#'
        # Symfony bootstrap.php pattern triggers PHPStan 2.x strictness
        - '#Call to function method_exists\(\) with .+ will always evaluate to true#'
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
