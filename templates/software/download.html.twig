{% extends 'base.html.twig' %}

{% block title %}Software Download - BimmerTech{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/software-download.css') }}">
{% endblock %}

{% block body %}
<div id="software-download">
    <div class="card">
        <div class="section-title">
            <h1 class="title">
                <span class="bold">Update the software for your</span><br>
                CarPlay / Android Auto MMI
            </h1>
        </div>

        <form id="softwareForm" class="software-form" novalidate>
            <div class="form-row">
                <div class="form-group">
                    <label for="version">Software Version <span class="required">*</span></label>
                    <input
                        type="text"
                        id="version"
                        name="version"
                        placeholder="e.g. 3.3.7.mmipri.c"
                        required
                    >
                    <span class="error-text" id="versionError"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group mcu-note">
                    <span class="mcu-label">MCU Version</span>
                    <span class="mcu-dash">&mdash;</span>
                    <span class="mcu-text">not required for this check</span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="hwVersion">HW Version <span class="required">*</span></label>
                    <input
                        type="text"
                        id="hwVersion"
                        name="hwVersion"
                        placeholder="e.g. CPAA_2024.01.15"
                        required
                    >
                    <span class="error-text" id="hwVersionError"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Check for update</button>
                <span
                    class="tooltip-icon"
                    data-tooltip="Enter your current software version to check if there is an update available. You can find your current software in MMI settings > System > System/firmware version."
                >?</span>
            </div>

            <div id="resultArea" class="result-area" style="display: none;">
                <div id="successResult" class="alert alert-success" style="display: none;">
                    <p>
                        <span id="successMsg"></span>
                        <a id="stLink" href="#" target="_blank" class="download-link" style="display: none;">ST Version</a>
                        <a id="gdLink" href="#" target="_blank" class="download-link" style="display: none;">GD Version</a>
                    </p>
                </div>

                <div id="errorResult" class="alert alert-error" style="display: none;">
                    <p id="errorMsg"></p>
                </div>
            </div>

            <p class="help-link-row">
                <a href="#" id="openModalLink" class="help-link">What is my current software?</a>
            </p>

            <div class="alert alert-warning">
                <div class="alert-warning-icon">&#9888;</div>
                <div class="alert-warning-content">
                    <strong>Warning!!!</strong>
                    <p>
                        Entering an incorrect software number and uploading it to another version of MMI will brick the MMI.<br>
                        In most cases, this is a reversible process, but impossible to perform without the assistance of our support.<br>
                        BimmerTech is not responsible for errors in software uploading by customers due to uploading the incorrect version.<br>
                        After this step, replacement under warranty cannot be considered.
                    </p>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-bottom">
        <a href="{{ shop_url }}" target="_blank" class="shop-link">&larr; Go back to the shop</a>
        <p class="disclaimer">
            BMW and MINI are registered trademarks of Bayerische Motoren Werke AG.
            BimmerTech is not affiliated with BMW AG in any way, and is not authorized
            by BMW AG to act as an official distributor or representative.
        </p>
    </div>
</div>

<div id="softwareModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-header-title">Finding your software version</span>
            <button id="closeModalBtn" class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="modal-placeholder">
                <div class="modal-steps">
                    <div class="modal-step">
                        <span class="modal-step-num">1</span>
                        <span class="modal-step-text">Open <strong>MMI Settings</strong></span>
                    </div>
                    <div class="modal-step-arrow">&rarr;</div>
                    <div class="modal-step">
                        <span class="modal-step-num">2</span>
                        <span class="modal-step-text">Go to <strong>System</strong></span>
                    </div>
                    <div class="modal-step-arrow">&rarr;</div>
                    <div class="modal-step">
                        <span class="modal-step-num">3</span>
                        <span class="modal-step-text">Find <strong>System/firmware version</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/software-download.js') }}"></script>
{% endblock %}
