#!/usr/bin/env php
<?php

$envFile = dirname(__DIR__) . '/.env';

if (!file_exists($envFile)) {
    echo "No .env file found. Run 'cp .env.example .env' first.\n";
    exit(1);
}

$content = file_get_contents($envFile);

if (str_contains($content, 'change-me-to-a-random-string')) {
    $secret = bin2hex(random_bytes(32));
    $content = str_replace('change-me-to-a-random-string', $secret, $content);
    file_put_contents($envFile, $content);
    echo "Generated APP_SECRET: {$secret}\n";
} else {
    echo "APP_SECRET already set.\n";
}
